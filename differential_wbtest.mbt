    let expected : Value = Symbol("app/name")
    assert_true(equivalent(actual, expected), msg="oracle case 183")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read("{:k0 ([[0.125] ()] {} false)}")
    let expected : Value = Mapping([
      (
        Keyword("k0"),
        List([
          Vector([Vector([Float(0.125)]), List([])]),
          Mapping([]),
          Bool(false),
        ]),
      ),
    ])
    assert_true(equivalent(actual, expected), msg="oracle case 184")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read(
      "([{:k0 \"中文🙂\" :k1 42 :k2 (-7)} (app/name)] 12.50M {:k0 ()})",
    )
    let expected : Value = List([
      Vector([
        Mapping([
          (Keyword("k0"), Text("中文🙂")),
          (Keyword("k1"), Integer("42")),
          (Keyword("k2"), List([Integer("-7")])),
        ]),
        List([Symbol("app/name")]),
      ]),
      Decimal("12.50"),
      Mapping([(Keyword("k0"), List([]))]),
    ])
    assert_true(equivalent(actual, expected), msg="oracle case 185")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read("(({} []))")
    let expected : Value = List([List([Mapping([]), Vector([])])])
    assert_true(equivalent(actual, expected), msg="oracle case 186")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read("[{:k0 [[:db/id] [\"中文🙂\" :db/id]]}]")
    let expected : Value = Vector([
      Mapping([
        (
          Keyword("k0"),
          Vector([
            Vector([Keyword("db/id")]),
            Vector([Text("中文🙂"), Keyword("db/id")]),
          ]),
        ),
      ]),
    ])
    assert_true(equivalent(actual, expected), msg="oracle case 187")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read(":db/id")
    let expected : Value = Keyword("db/id")
    assert_true(equivalent(actual, expected), msg="oracle case 188")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read("[()]")
    let expected : Value = Vector([List([])])
    assert_true(equivalent(actual, expected), msg="oracle case 189")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read("(() [0.125] [])")
    let expected : Value = List([List([]), Vector([Float(0.125)]), Vector([])])
    assert_true(equivalent(actual, expected), msg="oracle case 190")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read("12.50M")
    let expected : Value = Decimal("12.50")
    assert_true(equivalent(actual, expected), msg="oracle case 191")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read("({:k0 []} {})")
    let expected : Value = List([
      Mapping([(Keyword("k0"), Vector([]))]),
      Mapping([]),
    ])
    assert_true(equivalent(actual, expected), msg="oracle case 192")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read("true")
    let expected : Value = Bool(true)
    assert_true(equivalent(actual, expected), msg="oracle case 193")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read("12.50M")
    let expected : Value = Decimal("12.50")
    assert_true(equivalent(actual, expected), msg="oracle case 194")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read(
      "(12.50M {} {:k0 {:k0 {:k0 true}} :k1 ({:k0 12.50M :k1 app/name :k2 \"line\\nnext\"} (:db/id app/name -7) [42 app/name]) :k2 (nil)})",
    )
    let expected : Value = List([
      Decimal("12.50"),
      Mapping([]),
      Mapping([
        (
          Keyword("k0"),
          Mapping([(Keyword("k0"), Mapping([(Keyword("k0"), Bool(true))]))]),
        ),
        (
          Keyword("k1"),
          List([
            Mapping([
              (Keyword("k0"), Decimal("12.50")),
              (Keyword("k1"), Symbol("app/name")),
              (Keyword("k2"), Text("line\nnext")),
            ]),
            List([Keyword("db/id"), Symbol("app/name"), Integer("-7")]),
            Vector([Integer("42"), Symbol("app/name")]),
          ]),
        ),
        (Keyword("k2"), List([Nil])),
      ]),
    ])
    assert_true(equivalent(actual, expected), msg="oracle case 195")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read(
      "{:k0 ({:k0 false :k1 true} {:k0 \"line\\nnext\" :k1 {:k0 42}} ((false false true) false ())) :k1 ({:k0 [app/name false] :k1 [true 12.50M] :k2 \"hello\"} [app/name] [-7 ()])}",
    )
    let expected : Value = Mapping([
      (
        Keyword("k0"),
        List([
          Mapping([(Keyword("k0"), Bool(false)), (Keyword("k1"), Bool(true))]),
          Mapping([
            (Keyword("k0"), Text("line\nnext")),
            (Keyword("k1"), Mapping([(Keyword("k0"), Integer("42"))])),
          ]),
          List([
            List([Bool(false), Bool(false), Bool(true)]),
            Bool(false),
            List([]),
          ]),
        ]),
      ),
      (
        Keyword("k1"),
        List([
          Mapping([
            (Keyword("k0"), Vector([Symbol("app/name"), Bool(false)])),
            (Keyword("k1"), Vector([Bool(true), Decimal("12.50")])),
            (Keyword("k2"), Text("hello")),
          ]),
          Vector([Symbol("app/name")]),
          Vector([Integer("-7"), List([])]),
        ]),
      ),
    ])
    assert_true(equivalent(actual, expected), msg="oracle case 196")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read("42")
    let expected : Value = Integer("42")
    assert_true(equivalent(actual, expected), msg="oracle case 197")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  {
    let actual = read("12.50M")
    let expected : Value = Decimal("12.50")
    assert_true(equivalent(actual, expected), msg="oracle case 198")
    assert_eq(write(actual, canonical=true), write(expected, canonical=true))
  }
  let actual = read("(-7 {:k0 true} [() () []])")
  let expected : Value = List([
    Integer("-7"),
    Mapping([(Keyword("k0"), Bool(true))]),
    Vector([List([]), List([]), Vector([])]),
  ])
  assert_true(equivalent(actual, expected), msg="oracle case 199")
  assert_eq(write(actual, canonical=true), write(expected, canonical=true))
}
